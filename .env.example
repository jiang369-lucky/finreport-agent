# Copy to .env. Never put the key into chat, source code, or git.
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-235b-a22b-instruct-2507
# local deployment option: base URL http://127.0.0.1:8000/v1, model Qwen/Qwen3-8B
FIN_DATA_CUTOFF=2025-08-31
FIN_CONTEXT_TOKENS=12000
FIN_MAX_STEPS=10
FIN_MAX_TOOL_CALLS=16
FIN_RUN_TIMEOUT=180
FIN_MAX_COMPLETION_TOKENS=1800
FIN_REQUEST_TIMEOUT=55

# scripts.configure_database generates a local password; do not commit .env.
POSTGRES_USER=finagent
POSTGRES_DB=finreport
POSTGRES_PASSWORD=CHANGE_ME
FIN_POSTGRES_PORT=55432
DATABASE_URL=postgresql://finagent:CHANGE_ME@127.0.0.1:55432/finreport
FIN_DATABASE_SCHEMA=finagent
